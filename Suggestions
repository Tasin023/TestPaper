<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<style>
:root {
  --bg: #0a0a0f;
  --surface: rgba(22, 22, 34, 0.4);
  --surface-hover: rgba(30, 30, 46, 0.6);
  --surface2: #141420;
  --border: rgba(255, 255, 255, 0.05);
  --border-hover: rgba(255, 255, 255, 0.12);
  --text: #f1f1f6;
  --muted: #62627a;
  --accent: #3b82f6;

  --gold-bg: rgba(253, 224, 71, 0.03);
  --gold-border: rgba(234, 179, 8, 0.3);
  --gold-border-hover: rgba(234, 179, 8, 0.6);
  --gold-icon-bg: rgba(234, 179, 8, 0.1);
  --gold-text: #fef08a;
  --gold-sub: #ca8a04;

  --done-overlay: rgba(10, 10, 15, 0.85);
  --neon-cyan: #06b6d4;
  --neon-green: #10b981;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Plus Jakarta Sans', 'Hind Siliguri', sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ── HERO SECTION ── */
.hero-container {
  position: relative;
  border-bottom: 1px solid var(--border);
  background: radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
  padding: 80px 40px 60px;
}
.hero-grid {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
}
.hero-left h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 800;
  line-height: 0.9;
  letter-spacing: -2px;
  background: linear-gradient(135deg, #fff 30%, var(--muted));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-left p {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--muted);
  margin-top: 15px;
}
.legend {
  display: flex;
  gap: 20px;
  background: rgba(255,255,255,0.02);
  padding: 10px 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  backdrop-filter: blur(8px);
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--muted);
}
.legend-swatch {
  width: 8px; height: 8px;
  border-radius: 50%;
}
.swatch-gold { background: #eab308; box-shadow: 0 0 8px #eab308; }
.swatch-normal { background: var(--muted); }

/* ── TOP BAR ── */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 40px;
  border-bottom: 1px solid var(--border);
  background: rgba(10, 10, 15, 0.8);
  position: sticky; top: 0; z-index: 200;
  backdrop-filter: blur(20px);
}
.topbar-title {
  font-family: 'Syne', sans-serif;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.5px;
}
.topbar-stats {
  display: flex;
  gap: 24px;
  align-items: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
}
.stat-item { display:flex; align-items:center; gap:6px; }
.stat-val { color: #fff; font-weight: 500; }
.stat-lbl { color: var(--muted); }

.progress-ring-wrap { position: relative; width: 36px; height: 36px; }
.progress-ring-wrap svg { transform: rotate(-90deg); }
.progress-ring-bg { fill: none; stroke: var(--border); stroke-width: 2.5; }
.progress-ring-fill {
  fill: none;
  stroke: var(--text);
  stroke-width: 2.5;
  stroke-linecap: round;
  stroke-dasharray: 110;
  stroke-dashoffset: 110;
  transition: stroke-dashoffset 0.5s ease;
}
.ring-pct {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  color: var(--muted);
}

/* ── SUBJECT NAV ── */
.subject-nav {
  display: flex;
  gap: 6px;
  padding: 12px 40px;
  overflow-x: auto;
  border-bottom: 1px solid var(--border);
  background: var(--bg);
  position: sticky; top: 69px; z-index: 190;
}
.subject-nav::-webkit-scrollbar { display: none; }
.nav-btn {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  padding: 6px 14px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
  text-decoration: none;
}
.nav-btn:hover, .nav-btn.active {
  color: var(--text);
  background: rgba(255,255,255,0.03);
  border-color: var(--border);
}

/* ── PAGE LAYOUT ── */
.page { max-width: 1200px; margin: 0 auto; padding: 60px 40px 140px; }
.subject-section { margin-bottom: 80px; scroll-margin-top: 160px; }

.section-header {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 32px;
}
.section-num {
  font-family: 'Syne', sans-serif;
  font-size: 24px;
  color: var(--muted);
  opacity: 0.4;
}
.section-name {
  font-family: 'Syne', sans-serif;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.5px;
}
.section-paper-tag {
  font-size: 11px;
  font-weight: 500;
  padding: 3px 10px;
  border-radius: 6px;
  margin-left: 10px;
}
.tag-1st { color: var(--neon-cyan); background: rgba(6, 182, 212, 0.06); border: 1px solid rgba(6, 182, 212, 0.15); }
.tag-2nd { color: var(--neon-green); background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.15); }

/* ── VERTICAL GROUP STRUCTURE ── */
.sub-group { position: relative; margin-bottom: 40px; }
.vertical-label {
  position: absolute;
  left: -40px;
  top: 20px;
  transform: rotate(-90deg);
  transform-origin: left top;
  font-family: 'Syne', sans-serif;
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--muted);
  opacity: 0.3;
  white-space: nowrap;
}
.group-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 1px;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 16px;
}

/* ── CARD GRID ── */
.card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

/* ── BASE CARD ── */
.card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10px);
  transition: border-color 0.25s, background-color 0.25s, transform 0.2s;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}
.card:hover {
  border-color: var(--border-hover);
  background: var(--surface-hover);
  transform: translateY(-1px);
}

/* GOLD CARD */
.card.gold {
  background: var(--gold-bg);
  border-color: var(--gold-border);
}
.card.gold .card-title { color: var(--gold-text); }
.card.gold .card-sub { color: var(--gold-sub); opacity: 0.8; }
.card.gold .icon-wrap { background: var(--gold-icon-bg); border-color: rgba(234, 179, 8, 0.2); }
.card.gold:hover { border-color: var(--gold-border-hover); }

/* CARD INNER DETAILS */
.icon-wrap {
  width: 42px;
  height: 42px;
  border-radius: 8px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
  transition: transform 0.2s;
}
.card:hover .icon-wrap { transform: scale(1.05); }

.card-info { flex: 1; min-width: 0; }
.card-title {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
}
.card-sub {
  font-size: 12px;
  color: var(--muted);
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.marks-badge {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  font-weight: 500;
  padding: 2px 8px;
  border-radius: 4px;
  background: rgba(255,255,255,0.04);
  color: var(--muted);
  border: 1px solid var(--border);
}
.card.gold .marks-badge {
  background: rgba(234, 179, 8, 0.1);
  color: #fde047;
  border-color: rgba(234, 179, 8, 0.2);
}

/* DONE STATE */
.card.done { opacity: 0.25; }
.card.done .card-title { text-decoration: line-through; }
.card.done::after {
  content: ''; position: absolute; inset: 0;
  background: var(--done-overlay); pointer-events: none;
}
.card.done .done-stamp { display: flex !important; }

.done-stamp {
  display: none; position: absolute; inset: 0;
  align-items: center; justify-content: center; z-index: 2;
}
.stamp-inner {
  border: 1px solid var(--neon-green);
  border-radius: 4px;
  padding: 2px 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--neon-green);
  box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
  animation: stampIn 0.2s ease-out forwards;
}
@keyframes stampIn {
  0% { transform: scale(1.3); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* ── SYSTEM DIVIDER ── */
.paper-divider {
  display: flex;
  align-items: center;
  gap: 16px;
  margin: 40px 0 20px;
}
.paper-divider-label {
  font-family: 'Syne', sans-serif;
  font-size: 14px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}
.paper-divider-line { flex: 1; height: 1px; background: var(--border); }

/* ── TIPS & FOOTER STATS ── */
.tip-box {
  grid-column: 1 / -1;
  padding: 14px 18px;
  background: rgba(255,255,255,0.01);
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 12px;
  color: var(--muted);
  line-height: 1.6;
}
.tip-box strong { color: var(--text); font-weight: 500; }

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 16px 40px;
  background: rgba(10, 10, 15, 0.85);
  border-top: 1px solid var(--border);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  gap: 24px;
  z-index: 150;
}
.progress-track { flex: 1; height: 2px; background: var(--border); overflow: hidden; }
.progress-fill { height: 100%; background: var(--text); transition: width 0.4s ease; width: 0%; }
.bottom-nums { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--muted); }
.bottom-nums span { color: var(--text); }

/* RESPONSIVE */
@media (max-width: 768px) {
  .card-grid { grid-template-columns: 1fr; }
  .hero-grid { flex-direction: column; align-items: flex-start; gap: 24px; }
  .page { padding: 40px 20px 120px; }
  .topbar { padding: 16px 20px; }
  .subject-nav { padding: 12px 20px; top: 64px; }
  .vertical-label { display: none; }
  .sub-group { padding-left: 0 !important; }
}

/* ENTRY ANIMATIONS */
.card-grid .card { opacity: 0; animation: cardFadeIn 0.35s cubic-bezier(0.215, 0.610, 0.355, 1) forwards; }
@keyframes cardFadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
</head>
